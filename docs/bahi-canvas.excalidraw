   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "STEP 4 — THE AGENT PICKS THE DAY",
   "originalText": "STEP 4 — THE AGENT PICKS THE DAY",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00043",
   "type": "text",
   "x": 1226,
   "y": 902.5,
   "width": 294.05999999999995,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00043",
   "roundness": null,
   "seed": 302,
   "version": 1,
   "versionNonce": 560,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Plain arithmetic over that one person's\nown repayment history. Not a score, not\na model.\n\n\"Sharma pays on day 9 on average. Do\nnot chase before day 7.\"\n\n\"Patil is at day 40 and has never gone\npast 30. Something has changed — ask,\ndo not chase.\"",
   "originalText": "Plain arithmetic over that one person's\nown repayment history. Not a score, not\na model.\n\n\"Sharma pays on day 9 on average. Do\nnot chase before day 7.\"\n\n\"Patil is at day 40 and has never gone\npast 30. Something has changed — ask,\ndo not chase.\"",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
