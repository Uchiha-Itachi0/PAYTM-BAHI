   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "The nightly timer and the plumbing. At 11pm it\nworks out who to remind tomorrow, at what hour, and\nin what words.\n\nShows as a visual canvas — one screenshot the\njudges understand instantly, and the only sponsor\nwhose work is visible without opening a terminal.",
   "originalText": "The nightly timer and the plumbing. At 11pm it\nworks out who to remind tomorrow, at what hour, and\nin what words.\n\nShows as a visual canvas — one screenshot the\njudges understand instantly, and the only sponsor\nwhose work is visible without opening a terminal.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
