   "roundness": null,
   "seed": 617,
   "version": 1,
   "versionNonce": 1145,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "7  ·  WHAT YOU ACTUALLY BUILD IN 8 HOURS  (~5.5 OF CODING)",
   "originalText": "7  ·  WHAT YOU ACTUALLY BUILD IN 8 HOURS  (~5.5 OF CODING)",
