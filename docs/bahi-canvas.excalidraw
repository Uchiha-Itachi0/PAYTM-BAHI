   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "3 — THE CREDIT FILE THAT DOES NOT EXIST",
   "originalText": "3 — THE CREDIT FILE THAT DOES NOT EXIST",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00084",
   "type": "text",
   "x": 1056,
   "y": 1966.0,
   "width": 384.53999999999996,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00084",
   "roundness": null,
   "seed": 589,
   "version": 1,
   "versionNonce": 1093,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "A man who repays ₹200 every nine days for a year is\nproducing the only evidence of creditworthiness he\nwill ever have — and it evaporates into a paper\ndiary.\n\nCareful: RECORD it, never FUND it. The moment Paytm\nfinances the udhaar, CICRA s.2(f)(vi) makes it a\ncredit institution.",
   "originalText": "A man who repays ₹200 every nine days for a year is\nproducing the only evidence of creditworthiness he\nwill ever have — and it evaporates into a paper\ndiary.\n\nCareful: RECORD it, never FUND it. The moment Paytm\nfinances the udhaar, CICRA s.2(f)(vi) makes it a\ncredit institution.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
