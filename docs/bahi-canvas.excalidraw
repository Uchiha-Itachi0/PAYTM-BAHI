   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "AND THE HONEST RISK",
   "originalText": "AND THE HONEST RISK",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00087",
   "type": "text",
   "x": 1514,
   "y": 1966.0,
   "width": 384.53999999999996,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00087",
   "roundness": null,
   "seed": 610,
   "version": 1,
   "versionNonce": 1132,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Paytm shipped Business Khata in Jan 2020 — one-\nsided, reminders, no customer app. It is now an\norphaned page, absent from their own product nav.\n\nThat cuts both ways: they tried the diary and it\nwent nowhere. The half they never built is the half\nthat makes it work.",
   "originalText": "Paytm shipped Business Khata in Jan 2020 — one-\nsided, reminders, no customer app. It is now an\norphaned page, absent from their own product nav.\n\nThat cuts both ways: they tried the diary and it\nwent nowhere. The half they never built is the half\nthat makes it work.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00088",
   "type": "text",
