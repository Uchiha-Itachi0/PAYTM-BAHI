   "versionNonce": 1223,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Ramesh speaks to the Soundbox. A real phone on the\njudges' table buzzes. A judge taps Confirm. Both\nledgers update in front of them.\n\nThen: \"do not chase Sharma before day 7.\" Forty\nseconds, zero typing, and a loop the room watches\nclose.",
   "originalText": "Ramesh speaks to the Soundbox. A real phone on the\njudges' table buzzes. A judge taps Confirm. Both\nledgers update in front of them.\n\nThen: \"do not chase Sharma before day 7.\" Forty\nseconds, zero typing, and a loop the room watches\nclose.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
