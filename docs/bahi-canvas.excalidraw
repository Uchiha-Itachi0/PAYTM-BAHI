   "version": 1,
   "versionNonce": 963,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "The Soundbox on the counter. The app in Sharma's\npocket. UPI to settle in one tap.\n\nThis is the ingredient no startup can copy, and the\nreason this is a Paytm product rather than an app.",
   "originalText": "The Soundbox on the counter. The app in Sharma's\npocket. UPI to settle in one tap.\n\nThis is the ingredient no startup can copy, and the\nreason this is a Paytm product rather than an app.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00075",
   "type": "text",
   "x": 120,
   "y": 1875.75,
   "width": 357.28,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
