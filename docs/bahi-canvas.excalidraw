   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "4  ·  THE FOUR RULES WE BUILT IN  (THIS IS THE SLIDE THAT WINS)",
   "originalText": "4  ·  THE FOUR RULES WE BUILT IN  (THIS IS THE SLIDE THAT WINS)",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00048",
   "type": "text",
   "x": 120,
   "y": 1192.5,
   "width": 1031.24,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#adb5bd",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00048",
   "roundness": null,
   "seed": 337,
   "version": 1,
   "versionNonce": 625,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Every one of these is a line of Indian law that a debt-recording product walks into. Each became one implementation constraint.",
   "originalText": "Every one of these is a line of Indian law that a debt-recording product walks into. Each became one implementation constraint.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00049",
   "type": "rectangle",
   "x": 120,
   "y": 1226.0,
   "width": 430,
   "height": 259.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "#10331c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
