  {
   "id": "text-a00094",
   "type": "text",
   "x": 598,
   "y": 2268.25,
   "width": 376.99999999999994,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
