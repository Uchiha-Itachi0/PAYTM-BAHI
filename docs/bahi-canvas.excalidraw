   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "2 — THE SOUNDBOX GREW A MICROPHONE",
   "originalText": "2 — THE SOUNDBOX GREW A MICROPHONE",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00081",
   "type": "text",
   "x": 598,
   "y": 1966.0,
   "width": 384.53999999999996,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00081",
   "roundness": null,
   "seed": 568,
   "version": 1,
   "versionNonce": 1054,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Paytm's AI Soundbox (Oct 2025) already takes spoken\nquestions in 11 languages. ToneTag and Razorpay are\nbuilding on the same rail.\n\nNobody has pointed voice at credit. The hardware is\non the counter, paid for, and idle for this.",
   "originalText": "Paytm's AI Soundbox (Oct 2025) already takes spoken\nquestions in 11 languages. ToneTag and Razorpay are\nbuilding on the same rail.\n\nNobody has pointed voice at credit. The hardware is\non the counter, paid for, and idle for this.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00082",
   "type": "rectangle",
   "x": 1036,
   "y": 1921.25,
   "width": 430,
   "height": 194.75,
