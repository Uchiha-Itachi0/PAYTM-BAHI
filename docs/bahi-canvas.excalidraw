   "type": "text",
   "x": 1056,
   "y": 2268.25,
   "width": 384.53999999999996,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
