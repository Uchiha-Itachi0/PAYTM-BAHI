  },
  {
   "id": "text-a00037",
   "type": "text",
   "x": 502,
   "y": 902.5,
   "width": 294.05999999999995,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
