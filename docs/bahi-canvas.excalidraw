   "version": 1,
   "versionNonce": 976,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "6  ·  WHY PAYTM SPECIFICALLY",
   "originalText": "6  ·  WHY PAYTM SPECIFICALLY",
   "fontSize": 22,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
