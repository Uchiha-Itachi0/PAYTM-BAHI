   "roundness": null,
   "seed": 260,
   "version": 1,
   "versionNonce": 482,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "\"Sharma ko do sau udhaar.\"\n\nThe Soundbox hears it. No screen, no\ntyping, queue still moving. He can add\na tag to remember the man by — \"Room\n19, B wing\" — because he often does not\nknow Sharma's name either.",
   "originalText": "\"Sharma ko do sau udhaar.\"\n\nThe Soundbox hears it. No screen, no\ntyping, queue still moving. He can add\na tag to remember the man by — \"Room\n19, B wing\" — because he often does not\nknow Sharma's name either.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
