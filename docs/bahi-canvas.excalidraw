   "link": null,
   "locked": false,
   "text": "His own total. He owes money at three shops and\ncould not tell you the sum. If Ramesh's book says\n₹500 and he remembers ₹300, he has nothing — no\nentry, no date, no record.",
   "originalText": "His own total. He owes money at three shops and\ncould not tell you the sum. If Ramesh's book says\n₹500 and he remembers ₹300, he has nothing — no\nentry, no date, no record.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
