   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00026",
   "roundness": null,
   "seed": 183,
   "version": 1,
   "versionNonce": 339,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Badly, and in public. Being asked for money in\nfront of other customers is the enforcement\nmechanism. The relationship is the collateral, so\ncollecting the money costs the customer.",
   "originalText": "Badly, and in public. Being asked for money in\nfront of other customers is the enforcement\nmechanism. The relationship is the collateral, so\ncollecting the money costs the customer.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
