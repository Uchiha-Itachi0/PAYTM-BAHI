   "index": "a00056",
   "roundness": null,
   "seed": 393,
   "version": 1,
   "versionNonce": 729,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "3 — LET DEBTS DIE",
   "originalText": "3 — LET DEBTS DIE",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00057",
   "type": "text",
   "x": 1056,
   "y": 1270.75,
   "width": 384.53999999999996,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00057",
   "roundness": null,
   "seed": 400,
   "version": 1,
   "versionNonce": 742,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Limitation Act s.18: every acknowledgment restarts\na fresh three years, and there is no cap on\nrestarts.\n\nSo an app that keeps prompting turns a ₹200 debt\nfrom 2023 into one that is legally immortal. The\npaper diary let it die. We would have taken that\naway.\n\nWe stop prompting before the clock runs out, and we\ntell BOTH sides when an entry has expired.",
   "originalText": "Limitation Act s.18: every acknowledgment restarts\na fresh three years, and there is no cap on\nrestarts.\n\nSo an app that keeps prompting turns a ₹200 debt\nfrom 2023 into one that is legally immortal. The\npaper diary let it die. We would have taken that\naway.\n\nWe stop prompting before the clock runs out, and we\ntell BOTH sides when an entry has expired.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00058",
   "type": "rectangle",
   "x": 1494,
   "y": 1226.0,
   "width": 430,
   "height": 259.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "#10331c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00058",
   "roundness": {
    "type": 3
   },
   "seed": 407,
   "version": 1,
   "versionNonce": 755,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "text-a00059",
   "type": "text",
   "x": 1514,
   "y": 1242.0,
   "width": 269.7,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00059",
   "roundness": null,
   "seed": 414,
   "version": 1,
   "versionNonce": 768,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "4 — NEVER MONETISE THE REMINDER",
   "originalText": "4 — NEVER MONETISE THE REMINDER",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00060",
   "type": "text",
   "x": 1514,
   "y": 1270.75,
   "width": 376.99999999999994,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00060",
   "roundness": null,
   "seed": 421,
   "version": 1,
   "versionNonce": 781,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "CCPA's \"nagging\" dark pattern needs repetition AND\ncommercial gain. A reminder cadence supplies the\nrepetition by design — so we refuse to supply the\ngain. No fee, no cut, no lending upsell riding on\nit.\n\nAnd never shame. BNS s.308, Illustration (a):\nthreatening to expose someone unless they pay IS\nextortion. Seven years. That is the whole of\nDukanWala's business model.",
   "originalText": "CCPA's \"nagging\" dark pattern needs repetition AND\ncommercial gain. A reminder cadence supplies the\nrepetition by design — so we refuse to supply the\ngain. No fee, no cut, no lending upsell riding on\nit.\n\nAnd never shame. BNS s.308, Illustration (a):\nthreatening to expose someone unless they pay IS\nextortion. Seven years. That is the whole of\nDukanWala's business model.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00061",
   "type": "text",
   "x": 120,
   "y": 1507.75,
   "width": 1438.3999999999999,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00061",
   "roundness": null,
   "seed": 428,
   "version": 1,
   "versionNonce": 794,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Nobody else in this field has read any of this. It is four one-line constraints, and it is the difference between a debt product and a collections product.",
   "originalText": "Nobody else in this field has read any of this. It is four one-line constraints, and it is the difference between a debt product and a collections product.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00062",
   "type": "text",
