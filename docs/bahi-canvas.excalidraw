   "index": "a00049",
   "roundness": {
    "type": 3
   },
   "seed": 344,
   "version": 1,
   "versionNonce": 638,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "text-a00050",
   "type": "text",
   "x": 140,
   "y": 1242.0,
   "width": 261.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00050",
   "roundness": null,
   "seed": 351,
   "version": 1,
   "versionNonce": 651,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "1 — ACKNOWLEDGE, NEVER PROMISE",
   "originalText": "1 — ACKNOWLEDGE, NEVER PROMISE",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00051",
   "type": "text",
   "x": 140,
   "y": 1270.75,
   "width": 384.53999999999996,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00051",
   "roundness": null,
   "seed": 358,
   "version": 1,
   "versionNonce": 664,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "The button says \"I owe ₹200\". It must never say \"I\nwill pay by Friday\".\n\nAn acknowledgment of debt is recognised\nelectronically under IT Act s.4. A promise to pay a\nfixed sum is a demand promissory note — a\nnegotiable instrument, entry 1 of the IT Act's\nFirst Schedule, which puts it OUTSIDE the Act\nentirely.\n\nOne word in one button decides which statute\ngoverns the product.",
   "originalText": "The button says \"I owe ₹200\". It must never say \"I\nwill pay by Friday\".\n\nAn acknowledgment of debt is recognised\nelectronically under IT Act s.4. A promise to pay a\nfixed sum is a demand promissory note — a\nnegotiable instrument, entry 1 of the IT Act's\nFirst Schedule, which puts it OUTSIDE the Act\nentirely.\n\nOne word in one button decides which statute\ngoverns the product.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00052",
   "type": "rectangle",
   "x": 578,
   "y": 1226.0,
   "width": 430,
   "height": 259.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "#10331c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00052",
   "roundness": {
    "type": 3
   },
   "seed": 365,
   "version": 1,
   "versionNonce": 677,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "text-a00053",
   "type": "text",
   "x": 598,
   "y": 1242.0,
   "width": 348.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00053",
   "roundness": null,
   "seed": 372,
   "version": 1,
   "versionNonce": 690,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "2 — NEVER CHARGE A RUPEE ABOVE THE PRICE",
   "originalText": "2 — NEVER CHARGE A RUPEE ABOVE THE PRICE",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00054",
   "type": "text",
   "x": 598,
   "y": 1270.75,
   "width": 384.53999999999996,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00054",
   "roundness": null,
   "seed": 379,
   "version": 1,
   "versionNonce": 703,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "No late fee, no convenience charge, no interest.\n\nAll four state Money-Lenders Acts define a loan as\nan advance \"at interest\", whether of money or in\nkind. Maharashtra's definition catches \"any sum, by\nwhatsoever name called, in excess of the\nprincipal\".\n\nOne ₹10 late fee makes the shopkeeper an unlicensed\nmoney-lender in Karnataka and Delhi, where there is\nno trade-credit exclusion.",
   "originalText": "No late fee, no convenience charge, no interest.\n\nAll four state Money-Lenders Acts define a loan as\nan advance \"at interest\", whether of money or in\nkind. Maharashtra's definition catches \"any sum, by\nwhatsoever name called, in excess of the\nprincipal\".\n\nOne ₹10 late fee makes the shopkeeper an unlicensed\nmoney-lender in Karnataka and Delhi, where there is\nno trade-credit exclusion.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00055",
   "type": "rectangle",
   "x": 1036,
   "y": 1226.0,
   "width": 430,
   "height": 259.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "#10331c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00055",
   "roundness": {
    "type": 3
   },
   "seed": 386,
   "version": 1,
   "versionNonce": 716,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "text-a00056",
   "type": "text",
   "x": 1056,
   "y": 1242.0,
   "width": 147.89999999999998,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
