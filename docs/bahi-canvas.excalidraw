   "locked": false,
   "text": "STEP 5 — ONE TAP CLEARS IT",
   "originalText": "STEP 5 — ONE TAP CLEARS IT",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00046",
   "type": "text",
   "x": 1588,
   "y": 902.5,
   "width": 294.05999999999995,
   "height": 130.0,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00046",
   "roundness": null,
   "seed": 323,
   "version": 1,
   "versionNonce": 599,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "The reminder carries a UPI button.\nSharma pays from the same screen he was\nreminded on. The entry closes on both\nsides at once, and both of them see it\nclose.\n\nNo fee. No cut. No cashback. See rule\n4.",
   "originalText": "The reminder carries a UPI button.\nSharma pays from the same screen he was\nreminded on. The entry closes on both\nsides at once, and both of them see it\nclose.\n\nNo fee. No cut. No cashback. See rule\n4.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
