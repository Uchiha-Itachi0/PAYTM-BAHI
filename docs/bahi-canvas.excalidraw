  },
  {
   "id": "text-a00074",
   "type": "text",
   "x": 1514,
   "y": 1680.0,
   "width": 384.53999999999996,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
