   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "STEP 1 — HE JOINS HIMSELF",
   "originalText": "STEP 1 — HE JOINS HIMSELF",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00034",
   "type": "text",
   "x": 140,
   "y": 902.5,
   "width": 294.05999999999995,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00034",
   "roundness": null,
   "seed": 239,
   "version": 1,
   "versionNonce": 443,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "A QR sticker sits by the till. Sharma\nscans it once and he is in: the shop's\nprofile, and from then on his own\nrunning balance. Ramesh does nothing —\nno typing a stranger's phone number\ninto a form.\n\nThis also happens to be the only design\nthat is legal to send reminders from.\nSee rule 4.",
   "originalText": "A QR sticker sits by the till. Sharma\nscans it once and he is in: the shop's\nprofile, and from then on his own\nrunning balance. Ramesh does nothing —\nno typing a stranger's phone number\ninto a form.\n\nThis also happens to be the only design\nthat is legal to send reminders from.\nSee rule 4.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
