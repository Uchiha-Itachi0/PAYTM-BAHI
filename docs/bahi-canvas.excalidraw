   "locked": false
  },
  {
   "id": "text-a00080",
   "type": "text",
   "x": 598,
   "y": 1937.25,
   "width": 295.79999999999995,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#69db7c",
