   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00029",
   "type": "text",
   "x": 1514,
   "y": 607.0,
   "width": 384.53999999999996,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00029",
   "roundness": null,
   "seed": 204,
   "version": 1,
   "versionNonce": 378,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "DukanWala, live today, sells shops \"instant\ncommunity alerts when a chronic non-payer enters\nyour neighborhood\". That is the state of the art: a\nblacklist. It is also, under BNS s.308, close to\nextortion.",
   "originalText": "DukanWala, live today, sells shops \"instant\ncommunity alerts when a chronic non-payer enters\nyour neighborhood\". That is the state of the art: a\nblacklist. It is also, under BNS s.308, close to\nextortion.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00030",
   "type": "text",
   "x": 120,
   "y": 730.25,
   "width": 844.4799999999999,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#ff8787",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00030",
   "roundness": null,
   "seed": 211,
   "version": 1,
   "versionNonce": 391,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "The money is real. The record is one-sided. The only enforcement anyone has built is shame.",
   "originalText": "The money is real. The record is one-sided. The only enforcement anyone has built is shame.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
