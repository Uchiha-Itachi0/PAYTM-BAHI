   "link": null,
   "locked": false,
   "text": "Ramesh runs a kirana in Kurla. About 400 people pay\nhim in a month. Around 40 of them do not pay today\n— they buy on udhaar and settle later.",
   "originalText": "Ramesh runs a kirana in Kurla. About 400 people pay\nhim in a month. Around 40 of them do not pay today\n— they buy on udhaar and settle later.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
