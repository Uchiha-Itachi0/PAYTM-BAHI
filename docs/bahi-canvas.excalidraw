   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "STEP 3 — SHARMA CONFIRMS",
   "originalText": "STEP 3 — SHARMA CONFIRMS",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00040",
   "type": "text",
   "x": 864,
   "y": 902.5,
   "width": 286.52,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00040",
   "roundness": null,
   "seed": 281,
   "version": 1,
   "versionNonce": 521,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "His phone buzzes. \"₹200 recorded at\nRamesh Kirana, 22 September.\" He taps\nConfirm.\n\nIf he does not, the entry still stands\nin Ramesh's book — marked unconfirmed.\nRamesh never loses his own record. But\na confirmed entry is a fact, and an\nunconfirmed one is only a claim.",
   "originalText": "His phone buzzes. \"₹200 recorded at\nRamesh Kirana, 22 September.\" He taps\nConfirm.\n\nIf he does not, the entry still stands\nin Ramesh's book — marked unconfirmed.\nRamesh never loses his own record. But\na confirmed entry is a fact, and an\nunconfirmed one is only a claim.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
