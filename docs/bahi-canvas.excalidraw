   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "1 — BOTH SIDES ARE ALREADY INSTALLED",
   "originalText": "1 — BOTH SIDES ARE ALREADY INSTALLED",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00078",
   "type": "text",
   "x": 140,
   "y": 1966.0,
   "width": 354.37999999999994,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00078",
   "roundness": null,
   "seed": 547,
   "version": 1,
   "versionNonce": 1015,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Every ledger app has the shopkeeper and not the\ncustomer. OkCredit markets that as a feature:\n\"Customer ko app ki zaroorat nahi.\"\n\nTwo-sided is the whole idea, and it needs both\nhalves already in people's pockets. Exactly one\ncompany in India has that.",
   "originalText": "Every ledger app has the shopkeeper and not the\ncustomer. OkCredit markets that as a feature:\n\"Customer ko app ki zaroorat nahi.\"\n\nTwo-sided is the whole idea, and it needs both\nhalves already in people's pockets. Exactly one\ncompany in India has that.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle-a00079",
   "type": "rectangle",
   "x": 578,
   "y": 1921.25,
   "width": 430,
   "height": 194.75,
   "angle": 0,
   "strokeColor": "#69db7c",
   "backgroundColor": "#10331c",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00079",
   "roundness": {
    "type": 3
   },
