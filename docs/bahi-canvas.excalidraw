   "roundness": null,
   "seed": 680,
   "version": 1,
   "versionNonce": 1262,
   "isDeleted": false,
   "boundElements": null,
   "updatedAt": 1,
   "link": null,
   "locked": false,
   "text": "Cache every voice response to disk — the venue wifi\nwill fail. Record a backup video while the thing\nstill works.\n\nDO NOT BUILD: auth, real UPI, a real Soundbox\nintegration, the chat thread, or the second shop.",
   "originalText": "Cache every voice response to disk — the venue wifi\nwill fail. Record a backup video while the thing\nstill works.\n\nDO NOT BUILD: auth, real UPI, a real Soundbox\nintegration, the chat thread, or the second shop.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
