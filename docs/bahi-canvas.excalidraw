  },
  {
   "id": "text-a00102",
   "type": "text",
   "x": 120,
   "y": 2558.25,
   "width": 95.69999999999999,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#ffd43b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
