   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "text-a00026",
   "type": "text",
   "x": 1056,
   "y": 607.0,
   "width": 369.46,
   "height": 65.0,
   "angle": 0,
   "strokeColor": "#e9ecef",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
